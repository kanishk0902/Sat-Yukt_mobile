# SECRETS. This file (as backend/.env) must never be committed to git or
# shipped anywhere near the mobile app bundle. It only runs on your machine.

# Google AI Studio key for Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Cloud Speech-to-Text API key (recommended STT provider — best
# accuracy for all 9 app languages, has a genuine free tier: 60 min/month
# free, then pay-as-you-go). Get one at https://console.cloud.google.com:
#   1. Create/select a project, enable the "Cloud Speech-to-Text API".
#   2. APIs & Services -> Credentials -> Create Credentials -> API key.
# If left blank, falls back to WISPR_API_KEY, then OPENAI_API_KEY below.
GOOGLE_STT_API_KEY=

# Wispr Flow API key (used only if GOOGLE_STT_API_KEY is unset).
WISPR_API_KEY=

# OpenAI key, used as the last-resort Whisper STT fallback (paid, no real
# free tier) if neither GOOGLE_STT_API_KEY nor WISPR_API_KEY is set/working.
OPENAI_API_KEY=

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Twilio Verify Service SID, used for phone number OTP during onboarding.
# Create one at Twilio Console -> Verify -> Services -> Create new.
TWILIO_VERIFY_SERVICE_SID=

# n8n webhook URL for WhatsApp scam-message handoff — feature disabled for now
# N8N_WEBHOOK_URL=

PORT=4000
